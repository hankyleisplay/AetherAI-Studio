{
  "name": "@hankyleisplay/aetherai-studio",
  "version": "3.7.4",
  "description": "Aether AI Studio 3.7.4 (AetherAgent) - Next-Gen Desktop Autonomous AI Agent System with Real-Time Inference HUD, Live Code Canvas Sandbox, Cognitive Reasoning Modes, OCR Vision, Multi-Agent Swarm & 22 Enterprise Tools",
  "main": "cli.js",
  "bin": {
    "aetherai": "cli.js",
    "aether": "cli.js"
