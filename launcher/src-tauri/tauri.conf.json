{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherLauncher",
  "version": "4.0.0",
  "identifier": "com.aetherai.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aether AI Studio 4.0.0 - 官方專屬啟動器",
        "width": 640,
        "height": 780,
        "resizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
